{
  "title": "비전 요청 처리 순서 (/ws/vision)",
  "lanes": [
    {"id": "client", "label": "앱", "sub": "map-project-client"},
    {"id": "yolo", "label": "비전 서비스", "sub": "map-project-yolo"},
    {"id": "user", "label": "User BFF", "sub": "map-project-user"},
    {"id": "gemini", "label": "Gemini API", "sub": "외부"},
    {"id": "kakao", "label": "Kakao Local", "sub": "외부 (키가 있을 때)"},
    {"id": "wiki", "label": "위키백과 API", "sub": "외부 (연락처 설정 때)"}
  ],
  "steps": [
    {"kind": "band", "text": "① 연결: 수락 전에 권한 확인"},
    {"kind": "call", "from": "client", "to": "yolo", "text": "WebSocket 연결 · 하위 프로토콜 map.vision.v1 + bearer.<JWT>"},
    {"kind": "call", "from": "yolo", "to": "user", "text": "POST /api/v1/vision/permit {consume:false}"},
    {"kind": "ret", "from": "user", "to": "yolo", "text": "200 user_id · consent_revision · include_location"},
    {"kind": "ret", "from": "yolo", "to": "client", "text": "연결 수락 (map.vision.v1)"},
    {"kind": "band", "text": "② 요청마다: 검사 → 한도 사용 → 탐지·식별·검색"},
    {"kind": "call", "from": "client", "to": "yolo", "text": "VisionRequest JSON (frame_b64 · voice_text · location)"},
    {"kind": "self", "from": "yolo", "text": "입력 검사(JPEG·크기·위치 범위) · 연결 상한 · 자원 예약"},
    {"kind": "call", "from": "yolo", "to": "user", "text": "permit {consume:true, expected_revision}"},
    {"kind": "ret", "from": "user", "to": "yolo", "text": "200 (계정 한도 1 사용)"},
    {"kind": "self", "from": "yolo", "text": "YOLO 탐지 (전용 실행기 하나)"},
    {"kind": "call", "from": "yolo", "to": "kakao", "text": "좌표→주소 (위치 동의 + 키가 있을 때)"},
    {"kind": "ret", "from": "kakao", "to": "yolo", "text": "주소"},
    {"kind": "call", "from": "yolo", "to": "gemini", "text": "사진 + 질문 + 탐지 힌트 + 주소 또는 줄인 좌표"},
    {"kind": "ret", "from": "gemini", "to": "yolo", "text": "name · category · description · search_query"},
    {"kind": "call", "from": "yolo", "to": "wiki", "text": "검색 (YOLO_WIKIPEDIA_CONTACT 가 있을 때)"},
    {"kind": "ret", "from": "wiki", "to": "yolo", "text": "제목 · 요약 · 링크"},
    {"kind": "band", "text": "③ 전송 직전: 권한 다시 확인"},
    {"kind": "call", "from": "yolo", "to": "user", "text": "permit {consume:false, expected_revision}"},
    {"kind": "ret", "from": "user", "to": "yolo", "text": "200 (거절이면 결과를 버리고 닫음)"},
    {"kind": "ret", "from": "yolo", "to": "client", "text": "VisionResponse (status done · failed)"}
  ]
}
